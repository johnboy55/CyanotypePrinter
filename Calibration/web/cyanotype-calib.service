# systemd unit for the calibration web app on the Raspberry Pi.
# Install (adjust User and paths if your checkout isn't ~/CyanotypePrinter):
#   sudo cp web/cyanotype-calib.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now cyanotype-calib
# Logs: journalctl -u cyanotype-calib -f
[Unit]
Description=Cyanotype printer LUT calibration web app
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/CyanotypePrinter/Calibration
Environment=CALIB_DATA_DIR=/home/pi/cyanotype-calib
ExecStart=/home/pi/CyanotypePrinter/Calibration/.venv/bin/python web/app.py --port 8080
Restart=on-failure

[Install]
WantedBy=multi-user.target
